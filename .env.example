# Bu dosyayı .env adıyla kopyalayın ve yalnızca kullandığınız platformun satırlarını doldurun.
# .env dosyası hiçbir yere gönderilmez (.gitignore içinde). Anahtarları sohbete yapıştırmayın.

# --- Shopify (docs/api-anahtari/shopify.md) ---
# 2026 sonrası açılan uygulamalar: Client ID + Client Secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# 1 Ocak 2026'dan önce açılmış eski özel uygulamanız varsa yalnız bunu doldurun:
SHOPIFY_ADMIN_TOKEN=

# --- IdeaSoft (docs/api-anahtari/ideasoft.md) ---
IDEASOFT_CLIENT_ID=
IDEASOFT_CLIENT_SECRET=
IDEASOFT_REFRESH_TOKEN=

# --- İkas (docs/api-anahtari/ikas.md) ---
IKAS_CLIENT_ID=
IKAS_CLIENT_SECRET=

# --- DataForSEO (isteğe bağlı; config.json → keywords.source = "dataforseo") ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Blog görseli API ile üretilecekse (config.json → engines.image = "api") ---
OPENAI_API_KEY=
GEMINI_API_KEY=
